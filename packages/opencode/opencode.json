{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "formatter": true,
  "lsp": true,
  "instructions": ["README.md"],
  "plugin": ["@dietrichgebert/ponytail"],
  "mcp": {
    "jina": {
      "type": "remote",
      "url": "https://mcp.jina.ai/v1",
      "headers": {
        "Authorization": "Bearer {env:JINA_API_KEY}"
      }
    },
    "zai-web-search": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
      "headers": {
        "Authorization": "Bearer {env:Z_AI_API_KEY}"
      }
    },
    "zai-web-reader": {
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/web_reader/mcp",
      "headers": {
        "Authorization": "Bearer {env:Z_AI_API_KEY}"
      }
    },
    "zread": {
      "enabled": false,
      "type": "remote",
      "url": "https://api.z.ai/api/mcp/zread/mcp",
      "headers": {
        "Authorization": "Bearer {env:Z_AI_API_KEY}"
      }
    },
    "zai-vision": {
      "enabled": false,
      "type": "local",
      "command": ["bunx", "-y", "@z_ai/mcp-server"],
      "environment": {
        "Z_AI_API_KEY": "{env:Z_AI_API_KEY}",
        "Z_AI_MODE": "ZAI"
      }
    }
  },
  "provider": {
    "huggingface-endpoint": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Hugging Face Inference Endpoint",
      "options": {
        "baseURL": "{env:HF_IE_URL}",
        "apiKey": "{env:HF_IE_INFERENCE}"
      },
      "models": {
        "Qwen/Qwen3.8-27B": {
          "name": "Qwen 3.8 27B (Hugging Face)"
        }
      }
    },
    "zai-coding-plan": {
      "options": {
        "apiKey": "{env:Z_AI_API_KEY}"
      }
    }
  },
  "permission": {
    "read": {
      "**/.env*": "deny"
    }
  }
}
